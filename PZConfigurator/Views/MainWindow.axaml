<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PZConfigurator.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="PZConfigurator.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="920" Height="680" MinWidth="780" MinHeight="420">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:BoolSettingVM">
            <Border BorderBrush="#28888888" BorderThickness="0,0,0,1" Margin="0,0,0,3"
                    IsVisible="{Binding IsVisible}">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Key}" MinWidth="200" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontWeight="Medium"
                               ToolTip.Tip="{Binding Tooltip}" />
                    <CheckBox Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding IsChecked}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:EnumSettingVM">
            <Border BorderBrush="#28888888" BorderThickness="0,0,0,1" Margin="0,0,0,3"
                    IsVisible="{Binding IsVisible}">
                <Grid ColumnDefinitions="*,250" Margin="0,2">
                    <TextBlock Text="{Binding Key}" MinWidth="200" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontWeight="Medium"
                               ToolTip.Tip="{Binding Tooltip}" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Right" MinWidth="250"
                              ItemsSource="{Binding Items}"
                              HorizontalContentAlignment="Left"
                              SelectedIndex="{Binding SelectedIndex}"
                              ToolTip.Tip="{Binding Tooltip}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:NumberSettingVM">
            <Border BorderBrush="#28888888" BorderThickness="0,0,0,1" Margin="0,0,0,3"
                    IsVisible="{Binding IsVisible}">
                <Grid ColumnDefinitions="*,160" Margin="0,2">
                    <TextBlock Text="{Binding Key}" MinWidth="200" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontWeight="Medium"
                               ToolTip.Tip="{Binding Tooltip}" />
                    <NumericUpDown Grid.Column="1" HorizontalAlignment="Right" Width="160"
                                   Value="{Binding NumberValue}" FormatString="0.0######"
                                   Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                                   VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:TextSettingVM">
            <Border BorderBrush="#28888888" BorderThickness="0,0,0,1" Margin="0,0,0,3"
                    IsVisible="{Binding IsVisible}">
                <Grid ColumnDefinitions="*,320" Margin="0,2">
                    <TextBlock Text="{Binding Key}" MinWidth="200" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontWeight="Medium"
                               ToolTip.Tip="{Binding Tooltip}" />
                    <TextBox Grid.Column="1" HorizontalAlignment="Right" Width="320"
                             Text="{Binding Text}" IsReadOnly="{Binding IsReadOnly}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Status}" Margin="0,6,0,0"
                       Foreground="SlateGray" TextWrapping="Wrap" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8" RowDefinitions="Auto,Auto">
            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" Grid.Row="0" MinWidth="220"
                      ItemsSource="{Binding Servers}"
                      SelectedItem="{Binding SelectedServer}" />
            <Grid Grid.Column="2" Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="8,0,0,0">
                <Button Content="Refresh" Command="{Binding RefreshServerListCommand}" />
                <Button Grid.Column="1" Content="Browse..." x:Name="BrowseBtn" Click="Browse_Click" Margin="6,0,0,0" />
                <TextBlock Grid.Column="2" Text="{Binding Folder}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="SlateGray" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Button Grid.Column="3" Grid.Row="0" Content="Save"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsDirty}" />

            <TextBox Grid.Row="1" Grid.ColumnSpan="4" PlaceholderText="Search settings..."
                     Text="{Binding SearchText}" Margin="0,8,0,0" />
        </Grid>

        <TabControl>
            <TabItem Header="Server (ini)">
                <Grid ColumnDefinitions="220,*">
                    <ListBox ItemsSource="{Binding IniGroups}" SelectedItem="{Binding IniSelected}"
                             BorderThickness="0,0,1,0"
                             BorderBrush="#28888888" Margin="0,4,4,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" Margin="4,3" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ScrollViewer Grid.Column="1">
                        <ItemsControl ItemsSource="{Binding IniSelected.Items}" Margin="8,0,10,0" />
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Sandbox">
                <Grid ColumnDefinitions="220,*">
                    <ListBox ItemsSource="{Binding SandboxGroups}" SelectedItem="{Binding SandboxSelected}"
                             BorderThickness="0,0,1,0"
                             BorderBrush="#28888888" Margin="0,4,4,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" Margin="4,3" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ScrollViewer Grid.Column="1">
                        <ItemsControl ItemsSource="{Binding SandboxSelected.Items}" Margin="8,0,10,0" />
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
