<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PZConfigurator.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="PZConfigurator.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/appimage.ico"
        Title="{Binding Title}"
        Width="920" Height="680" MinWidth="780" MinHeight="420">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- yellow text = value changed since load/last save -->
        <Style Selector="TextBlock.modified">
            <Setter Property="Foreground" Value="#FFDD33" />
        </Style>
        <!-- filter/status emphasis -->
        <Style Selector="Button.active">
            <Setter Property="Background" Value="#FFDD33" />
            <Setter Property="Foreground" Value="#FF1B1B1B" />
        </Style>
        <Style Selector="Button.dirty">
            <Setter Property="Background" Value="#FFDD33" />
            <Setter Property="Foreground" Value="#FF1B1B1B" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#FFD06B6B" />
        </Style>
        <Style Selector="TextBlock.warn">
            <Setter Property="Foreground" Value="#FFD6A24A" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:BoolSettingVM">
            <Border BorderBrush="#28888888" BorderThickness="0,0,0,1" Margin="0,0,0,3"
                    IsVisible="{Binding IsVisible}">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Key}" MinWidth="140" TextWrapping="Wrap" FontWeight="Medium"
                                   Classes.modified="{Binding IsModified}"
                                   ToolTip.Tip="{Binding Tooltip}" />
                        <TextBlock Text="{Binding MatchCategory}" FontSize="11" Foreground="SlateGray"
                                   IsVisible="{Binding HasMatchCategory}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" HorizontalAlignment="Right" IsChecked="{Binding IsChecked}" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:EnumSettingVM">
            <Border BorderBrush="#28888888" BorderThickness="0,0,0,1" Margin="0,0,0,3"
                    IsVisible="{Binding IsVisible}">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Key}" MinWidth="140" TextWrapping="Wrap" FontWeight="Medium"
                                   Classes.modified="{Binding IsModified}"
                                   ToolTip.Tip="{Binding Tooltip}" />
                        <TextBlock Text="{Binding MatchCategory}" FontSize="11" Foreground="SlateGray"
                                   IsVisible="{Binding HasMatchCategory}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <ComboBox MinWidth="250"
                                  ItemsSource="{Binding Items}"
                                  HorizontalContentAlignment="Left"
                                  SelectedIndex="{Binding SelectedIndex}"
                                  ToolTip.Tip="{Binding Tooltip}" />
                        <TextBlock Text="{Binding OutOfRangeText}" IsVisible="{Binding HasOutOfRangeText}"
                                   VerticalAlignment="Center" Foreground="#E0C87832" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:NumberSettingVM">
            <Border BorderBrush="#28888888" BorderThickness="0,0,0,1" Margin="0,0,0,3"
                    IsVisible="{Binding IsVisible}">
                <Grid ColumnDefinitions="*,184" Margin="0,2">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Key}" MinWidth="140" TextWrapping="Wrap" FontWeight="Medium"
                                   Classes.modified="{Binding IsModified}"
                                   ToolTip.Tip="{Binding Tooltip}" />
                        <TextBlock Text="{Binding MatchCategory}" FontSize="11" Foreground="SlateGray"
                                   IsVisible="{Binding HasMatchCategory}" />
                    </StackPanel>
                    <NumericUpDown Grid.Column="1" HorizontalAlignment="Right" Width="184"
                                   ButtonSpinnerLocation="Left"
                                   Value="{Binding NumberValue}" FormatString="{Binding Format}"
                                   Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                                   VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:TextSettingVM">
            <Border BorderBrush="#28888888" BorderThickness="0,0,0,1" Margin="0,0,0,3"
                    IsVisible="{Binding IsVisible}">
                <Grid ColumnDefinitions="*,320" Margin="0,2">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Key}" MinWidth="140" TextWrapping="Wrap" FontWeight="Medium"
                                   Classes.modified="{Binding IsModified}"
                                   ToolTip.Tip="{Binding Tooltip}" />
                        <TextBlock Text="{Binding MatchCategory}" FontSize="11" Foreground="SlateGray"
                                   IsVisible="{Binding HasMatchCategory}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" HorizontalAlignment="Right" Width="320"
                             Text="{Binding Text}" IsReadOnly="{Binding IsReadOnly}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Status}" Margin="0,6,0,0"
                       Foreground="SlateGray" TextWrapping="Wrap"
                       Classes.error="{Binding IsStatusError}" Classes.warn="{Binding IsStatusWarn}" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8" RowDefinitions="Auto,Auto">
            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" Grid.Row="0" MinWidth="220"
                      ItemsSource="{Binding Servers}"
                      SelectedItem="{Binding SelectedServer}" />
            <Grid Grid.Column="2" Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="8,0,0,0">
                <Button Content="Refresh" Command="{Binding RefreshServerListCommand}" />
                <Button Grid.Column="1" Content="Browse..." x:Name="BrowseBtn" Click="Browse_Click" Margin="6,0,0,0" />
                <TextBlock Grid.Column="2" Text="{Binding Folder}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="SlateGray" TextTrimming="CharacterEllipsis" />
            </Grid>
            <StackPanel Grid.Column="3" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Only modified" Classes.active="{Binding OnlyModified}"
                        Command="{Binding ToggleOnlyModifiedCommand}"
                        ToolTip.Tip="Show only settings changed since load / last save"
                        Margin="0,0,8,0" />
                <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}"
                        Classes.dirty="{Binding IsDirty}" />
            </StackPanel>

            <Grid Grid.Row="1" Grid.ColumnSpan="4" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBox x:Name="SearchBox"
                         PlaceholderText="Search settings... (Esc clears, Ctrl+F focuses)"
                         Text="{Binding SearchText}" />
                <Button Grid.Column="1" Content="×" Width="30" Padding="0,0,0,2"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        FontSize="16" FontFamily="Segoe UI Symbol"
                        IsVisible="{Binding HasSearchText}"
                        Command="{Binding ClearSearchCommand}"
                        ToolTip.Tip="Clear search" />
            </Grid>
        </Grid>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Server (ini)">
                <Grid ColumnDefinitions="Auto,*">
                    <ListBox ItemsSource="{Binding IniGroups}" SelectedItem="{Binding IniSelected}"
                             MinWidth="220" IsVisible="{Binding !IsSearching}"
                             BorderThickness="0,0,1,0"
                             BorderBrush="#28888888" Margin="0,4,4,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Margin="4,3">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ModifiedCount}" Margin="6,0,0,0"
                                               IsVisible="{Binding HasModified}"
                                               Foreground="#FFDD33" FontWeight="Bold" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Column="1">
                        <ScrollViewer IsVisible="{Binding IsSearching}" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding IniMatches}" Margin="8,0,10,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        </ScrollViewer>
                        <ScrollViewer IsVisible="{Binding !IsSearching}" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding IniSelected.Items}" Margin="8,0,10,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Sandbox">
                <Grid ColumnDefinitions="Auto,*">
                    <ListBox ItemsSource="{Binding SandboxGroups}" SelectedItem="{Binding SandboxSelected}"
                             MinWidth="220" IsVisible="{Binding !IsSearching}"
                             BorderThickness="0,0,1,0"
                             BorderBrush="#28888888" Margin="0,4,4,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Margin="4,3">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ModifiedCount}" Margin="6,0,0,0"
                                               IsVisible="{Binding HasModified}"
                                               Foreground="#FFDD33" FontWeight="Bold" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Template:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Templates}"
                                      AutomationProperties.AutomationId="TemplateCombo"
                                      SelectedItem="{Binding TemplateSelected}"
                                      PlaceholderText="Choose a game mode"
                                      MinWidth="200">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Apply" Command="{Binding ApplyTemplateCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsSearching}" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SandboxMatches}" Margin="8,0,10,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        </ScrollViewer>
                        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsSearching}" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SandboxSelected.Items}" Margin="8,0,10,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
