<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PZConfigurator.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="PZConfigurator.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="920" Height="680">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:SettingGroupVM">
            <StackPanel Spacing="4" Margin="0,10,0,14">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" />
                <ItemsControl ItemsSource="{Binding Items}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:BoolSettingVM">
            <Border BorderBrush="#28888888" BorderThickness="0,0,0,1" Margin="0,0,0,3">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2" IsVisible="{Binding IsVisible}">
                    <TextBlock Text="{Binding Key}" Width="300" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontWeight="Medium"
                               ToolTip.Tip="{Binding Tooltip}" />
                    <CheckBox IsChecked="{Binding IsChecked}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:EnumSettingVM">
            <Border BorderBrush="#28888888" BorderThickness="0,0,0,1" Margin="0,0,0,3">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2" IsVisible="{Binding IsVisible}">
                    <TextBlock Text="{Binding Key}" Width="300" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontWeight="Medium"
                               ToolTip.Tip="{Binding Tooltip}" />
                    <ComboBox MinWidth="220" ItemsSource="{Binding Items}"
                              SelectedIndex="{Binding SelectedIndex}"
                              ToolTip.Tip="{Binding Tooltip}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:NumberSettingVM">
            <Border BorderBrush="#28888888" BorderThickness="0,0,0,1" Margin="0,0,0,3">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2" IsVisible="{Binding IsVisible}">
                    <TextBlock Text="{Binding Key}" Width="300" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontWeight="Medium"
                               ToolTip.Tip="{Binding Tooltip}" />
                    <NumericUpDown Width="150" Value="{Binding NumberValue}" FormatString="0.0######"
                                   Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                                   VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:TextSettingVM">
            <Border BorderBrush="#28888888" BorderThickness="0,0,0,1" Margin="0,0,0,3">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2" IsVisible="{Binding IsVisible}">
                    <TextBlock Text="{Binding Key}" Width="300" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontWeight="Medium"
                               ToolTip.Tip="{Binding Tooltip}" />
                    <TextBox Width="320" Text="{Binding Text}" IsReadOnly="{Binding IsReadOnly}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Status}" Margin="0,6,0,0"
                       Foreground="SlateGray" TextWrapping="Wrap" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8" RowDefinitions="Auto,Auto">
            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" Grid.Row="0" MinWidth="220"
                      ItemsSource="{Binding Servers}"
                      SelectedItem="{Binding SelectedServer}" />
            <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                <Button Content="Refresh" Command="{Binding RefreshServerListCommand}" />
                <Button Content="Browse..." x:Name="BrowseBtn" Click="Browse_Click" />
                <TextBlock Text="{Binding Folder}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="SlateGray" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="3" Grid.Row="0" Content="Save"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsDirty}" />

            <TextBox Grid.Row="1" Grid.ColumnSpan="4" PlaceholderText="Search settings..."
                     Text="{Binding SearchText}" Margin="0,8,0,0" />
        </Grid>

        <TabControl>
            <TabItem Header="Server (ini)">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding IniGroups}" Margin="0,0,10,0" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Sandbox">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding SandboxGroups}" Margin="0,0,10,0" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
